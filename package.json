{
  "name": "carecast-ai",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "engines": { "node": ">=24 <25" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:check": "node scripts/lint-check.cjs",
    "preview": "vite preview",
    "test:server": "npm test --prefix server",
    "test:regression": "node --test \"tests/regression/*.test.mjs\"",
    "verify:db": "node scripts/verify-db.cjs",
    "verify:times": "node scripts/check-broadcast-times.cjs",
    "export-env": "node scripts/export-settings-to-env.cjs",
    "verify": "npm run lint:check && npm run build && npm run test:server && npm run test:regression && npm run verify:db && npm run verify:times",
    "package": "node scripts/package-release.cjs",
    "notices": "node scripts/third-party-notices.cjs",
    "export:public": "node scripts/export-public.cjs",
    "package:installer": "node scripts/package-installer.cjs",
    "setup:tts": "node scripts/setup-tts.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12"
  }
}
