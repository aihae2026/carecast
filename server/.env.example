# server/.env — 값을 채운 뒤 이 파일을 "server/.env"라는 이름으로 저장하세요.
# (이 파일 .env.example 자체는 그대로 두고, 복사본을 만들어서 채우는 걸 권장)
#
# 서버를 재시작할 때 한 번, settings 테이블에 "아직 없는 키"만 자동으로 채워줍니다.
# 관리자 화면(API 연동 설정)에서 이미 입력한 값은 덮어쓰지 않습니다.
# (예외: 아래 AUTO_UPDATE_ENABLED 는 화면에 칸이 없어 이 파일 값이 언제나 이깁니다.)
# 이 파일과 DB(server/db/database.db)에는 키가 그대로 적힙니다 — 남에게 보내거나 저장소에 올리지 마세요.
# 모르는 항목은 빈 채로 두거나 그 줄을 지워도 됩니다 — 없는 줄은 그냥 무시됩니다.

# ── SwitchBot (조명/TV 자동 제어) ──────────────────────────────
# 토큰/시크릿: SwitchBot 앱 → 프로필 → 앱 버전 10번 연속 탭 → 개발자 옵션
# Device ID: SwitchBot 앱 → 해당 장치 → 장치 정보
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_DEVICE_ID=

# ── 기상청 API (공공데이터포털) ────────────────────────────────
# apihub.kma.go.kr 통합 인증키(특보·자외선·동네예보 공통) — 없으면 아래 개별 키 사용
KMA_APIHUB_KEY=
# data.go.kr에서 발급받은 개별 서비스키(위 통합키 없을 때 보조용)
KMA_API_KEY=
KMA_LIVING_API_KEY=
KMA_ALERT_API_KEY=
# 자외선관측 지점번호(108 서울 · 119 수원 · 105 강릉 · 159 부산. 비우면 예시값 108)
KMA_UV_STN=
# 생활기상지수 지역번호(10자리 행정구역 코드. 비우면 예시값 1100000000 = 서울특별시)
UV_AREA_NO=

# ── 위치 좌표 (날씨 조회 기준. 비우면 예시값 = 서울시청) ──────────
LOCATION_LAT=
LOCATION_LON=

# ── 에어코리아 (미세먼지) ──────────────────────────────────────
AIRKOREA_API_KEY=
# 측정소 이름(에어코리아 누리집에서 확인. 비우면 예시값 「중구」)
AIRKOREA_STATION=

# ── Google Calendar (OAuth 클라이언트) ─────────────────────────
# Client Secret은 발급 후 다시 볼 수 없으니 안전한 곳에 보관해두세요.
# Refresh/Access 토큰은 관리자 화면에서 "Google 연동" 버튼으로 발급되므로 여기 넣지 않습니다.
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=

# ── Gemini (AI 방송문 생성 / 자연어 예약) ──────────────────────
# aistudio.google.com에서 발급. 관리자 화면 "AI · API 연동"에서도 입력 가능(둘 다 여기 넣을
# 필요 없음 — 관리자 화면에 이미 값이 있으면 이 파일은 무시됨).
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PROVIDER=

# ── Azure 음성 (선택 안내 음성 엔진) ─────────────────────────────
# portal.azure.com 에서 「Speech 서비스」를 만들고 키·지역(예: koreacentral)을 받는다. 무료 계층 월 50만 자.
# **기관마다 자기 구독·키**를 쓴다. 비워 두면 기본 엔진(이 PC 의 Supertonic)만 쓴다.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── 자동 업데이트 (기본 꺼짐) ─────────────────────────────────────
# 1 로 적으면 main 가지로 받아 둔 PC 가 10분마다 GitHub 에서 새 판을 받아(git pull → npm install →
# npm run build) 재시작합니다. **이 PC 에서 고친 파일은 지워지고(git checkout -- .) 상류의 새 코드가
# 바로 실행되므로**, 고쳐 쓰는 PC 나 포크에서는 켜지 마세요. README 「업데이트」 참조.
AUTO_UPDATE_ENABLED=
