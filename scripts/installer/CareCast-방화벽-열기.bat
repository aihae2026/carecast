@echo off
title CareCast - allow phone access
setlocal

:: CareCast - open the Windows firewall so phones on the same Wi-Fi can reach this PC.
::
:: THIS FILE MUST STAY PURE ASCII WITH CRLF LINE ENDINGS (user report 2026-09-17).
:: The Korean version (UTF-8, LF only, chcp 65001) broke on a laptop: cmd reads a batch
:: file by byte offset, so with LF endings and multi-byte Korean text it resumed in the
:: middle of lines and ran fragments like "uired" and "3001" as commands. The rule was
:: never added, so the phone could not connect. Same lesson as installer-ascii.test.js.
:: Korean messages travel as base64 UTF-16LE PowerShell commands (like carecast-start.bat).
:: Generated by a script; server/test/firewall-bat-ascii.test.js pins ASCII + CRLF.
::
:: All profiles, but remote addresses are limited to the local subnet (same Wi-Fi/router).
:: Laptops often sit on a "Public" profile; a private-only rule silently did nothing there (2026-09-17).

:: Needs administrator rights. Elevate itself if not already.
net session > nul 2>&1
if not errorlevel 1 goto ADMIN
powershell -NoProfile -NonInteractive -EncodedCommand VwByAGkAdABlAC0ASABvAHMAdAAgACcAAK2suZDHIACMrVzVdMcgAETVlMZp1ciy5LIuACAAjK1c1SAAlMatzCAAPcx0xyAAKLd0uiAADDAIxg0wfLkgAAyy7LcgAPzIOMGUxi4AJwA=
:: Pass our own path through an env var, not inside '...': a folder name with ' broke the command (2026-09-26).
set "CC_SELF=%~f0"
powershell -NoProfile -Command "Start-Process -FilePath $env:CC_SELF -Verb RunAs"
exit /b 0

:ADMIN
powershell -NoProfile -NonInteractive -EncodedCommand 
:: Delete then add, so running this twice does not pile up rules.
netsh advfirewall firewall delete rule name="CareCast AI" > nul 2>&1
netsh advfirewall firewall add rule name="CareCast AI" dir=in action=allow protocol=TCP localport=3001,3443 profile=any remoteip=localsubnet > nul
if errorlevel 1 goto FAIL
powershell -NoProfile -NonInteractive -EncodedCommand 
pause
exit /b 0

:FAIL
powershell -NoProfile -NonInteractive -EncodedCommand 
pause
exit /b 1
